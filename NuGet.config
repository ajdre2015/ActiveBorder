<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Ignore inherited/private feeds but retain the official public source.
       The SDK may restore target and runtime packs from NuGet.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
